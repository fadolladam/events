# Docker Compose environment — copy to `.env` (same directory as docker-compose.yml)
# and fill in before any non-local deployment. Compose loads `.env` automatically.

# --- Required ---------------------------------------------------------------
# Generate once:  docker compose run --rm events-backend php artisan key:generate --show
APP_KEY=

# --- App -------------------------------------------------------------------
APP_URL=https://events.example.com

# --- Database (kept inside the compose network; port is loopback-only) -----
DB_DATABASE=events
DB_USERNAME=events_user
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-stronger
# DB_PORT=3306        # host-side port (bound to 127.0.0.1)

# --- First-party SPA session auth ----------------------------------------
# Comma-separated host[:port] the browser loads the app from.
SANCTUM_STATEFUL_DOMAINS=events.example.com
CORS_ALLOWED_ORIGINS=https://events.example.com
# true once you terminate TLS in front of the app:
SESSION_SECURE_COOKIE=true
