# RHB Events — configuration for XAMPP / any plain PHP + MySQL host.
#
#   cp .env.xampp .env
#   php artisan migrate --seed        (or import install/events.sql via phpMyAdmin)
#
# Assumes XAMPP defaults: MySQL on 127.0.0.1:3306, user "root", empty password.
# APP_KEY below is a fixed local key so setup needs no CLI key generation —
# run `php artisan key:generate` before using this anywhere real.

APP_NAME="RHB Events"
APP_ENV=local
APP_KEY=base64:zfsppIves0mKM0q/QM3hGky4e3KOusAOHjGuMGcJN0U=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database: XAMPP MySQL / MariaDB --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=events
DB_USERNAME=root
DB_PASSWORD=

# --- No extra services required (file/sync drivers) ---------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# First-party SPA cookie auth (served from the same origin as the API).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"
